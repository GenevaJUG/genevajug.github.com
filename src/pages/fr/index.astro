---
import Header from '../../components/Header.astro';
import NextSession from '../../components/NextSession.astro';
import PastSessions from '../../components/PastSessions.astro';
import Speakers from '../../components/Speakers.astro';
import Team from '../../components/Team.astro';
---

<!DOCTYPE html>
<html lang="fr" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GenevaJUG - Groupe d'utilisateurs Java de Genève</title>
    <link rel="icon" type="image/png" href="/apple_touch_icon.png" />
    <link rel="apple-touch-icon" href="/apple_touch_icon.png" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root[data-theme='light'] {
        --bg-primary: #ffffff;
        --bg-secondary: #f0f0f0;
        --text-primary: #000000;
        --text-secondary: #333333;
        --text-muted: #666666;
        --border-color: #e0e0e0;
      }

      :root[data-theme='dark'] {
        --bg-primary: #1a1a1a;
        --bg-secondary: #2a2a2a;
        --text-primary: #ffffff;
        --text-secondary: #cccccc;
        --text-muted: #999999;
        --border-color: #444444;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
          'Helvetica Neue', Arial, sans-serif;
        line-height: 1.6;
        background: var(--bg-primary);
        color: var(--text-secondary);
        transition: background-color 0.3s ease, color 0.3s ease;
      }

      .hero {
        min-height: calc(100vh - 80px);
        background: var(--bg-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 2rem;
      }

      .hero-content {
        max-width: 800px;
      }

      .hero h1 {
        font-size: 3.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
        color: var(--text-primary);
      }

      .hero-tagline {
        font-size: 1.8rem;
        font-weight: 300;
        margin-bottom: 2rem;
        color: var(--text-muted);
      }

      .social-links {
        display: flex;
        justify-content: center;
        gap: 2rem;
        margin-top: 2rem;
      }

      .social-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
        background: var(--bg-secondary);
        border: 2px solid var(--border-color);
        border-radius: 50%;
        color: var(--text-secondary);
        text-decoration: none;
        transition: all 0.3s ease;
        font-size: 1.5rem;
      }

      .social-link.newsletter-link {
        width: auto;
        min-width: 50px;
        padding: 0 1rem;
        border-radius: 999px;
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.02em;
      }

      .social-link:hover {
        background: var(--text-muted);
        border-color: var(--text-muted);
        color: var(--bg-primary);
        transform: translateY(-2px);
      }

      .about-section {
        scroll-margin-top: 80px;
        padding: 4rem 2rem;
        max-width: 900px;
        margin: 0 auto;
        margin-bottom: 10rem;
        background: var(--bg-primary);
        min-height: 80vh;
      }

      .about-section h2 {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 2rem;
        color: var(--text-primary);
      }

      .about-section p {
        font-size: 1.1rem;
        line-height: 1.8;
        margin-bottom: 1.5rem;
        color: var(--text-secondary);
      }

      .newsletter-section {
        padding: 0 2rem 4rem;
      }

      .newsletter-card {
        max-width: 900px;
        margin: 0 auto;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 2rem;
      }

      .newsletter-card h2 {
        font-size: 2rem;
        margin-bottom: 0.75rem;
        color: var(--text-primary);
      }

      .newsletter-card p {
        margin-bottom: 1.25rem;
        color: var(--text-secondary);
      }

      .newsletter-form {
        display: grid;
        gap: 0.75rem;
      }

      .newsletter-fields {
        display: grid;
        gap: 0.75rem;
      }

      .newsletter-form input {
        width: 100%;
        min-height: 44px;
        padding: 0.75rem 0.85rem;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        font: inherit;
        background: var(--bg-primary);
        color: var(--text-primary);
      }

      .newsletter-rgpd {
        font-size: 0.9rem;
        color: var(--text-muted);
        line-height: 1.5;
      }

      .newsletter-submit {
        display: flex;
        justify-content: flex-end;
      }

      .newsletter-submit input {
        width: auto;
        background: #007bff;
        color: white;
        border: none;
        border-radius: 6px;
        padding: 0.75rem 1.5rem;
        cursor: pointer;
        font-weight: 600;
      }

      @media (max-width: 768px) {
        .hero h1 {
          font-size: 2rem;
        }

        .hero-tagline {
          font-size: 1.2rem;
        }

        .social-links {
          gap: 1rem;
        }

        .social-link {
          width: 45px;
          height: 45px;
          font-size: 1.2rem;
        }

        .about-section {
          padding: 3rem 1.5rem;
        }

        .about-section h2 {
          font-size: 1.5rem;
        }

        .about-section p {
          font-size: 1rem;
        }
      }
    </style>
  </head>
  <body>
    <Header locale="fr" />

    <section class="hero">
      <div class="hero-content">
        <h1>GenevaJUG</h1>
        <p class="hero-tagline">La communauté Java qui fait tourner les idées</p>

        <div class="social-links">
          <a href="https://www.linkedin.com/groups/12345/" class="social-link" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
            <i class="fab fa-linkedin-in"></i>
          </a>
          <a href="#newsletter" class="social-link newsletter-link" aria-label="S'inscrire à la lettre d'information">✉️ S'inscrire à la newsletter</a>
        </div>
      </div>
    </section>

    <section id="about" class="about-section">
      <h2>Le Geneva Java User Group en quelques mots...</h2>
      <p>Le GenevaJUG est un groupe d'utilisateurs Java ayant pour but de réunir les acteurs du langage (professionnels, communautés open source, institutions, étudiants, enseignants…) afin d'échanger des idées et de discuter des avancées technologiques de la plateforme Java.</p>
      <p>Nous nous rencontrons le dernier mardi du mois. Les réunions sont gratuites, ouvertes à tous et consistent en une présentation technique, une démonstration d'un produit, ou une table ronde. Après la réunion nous nous retrouvons généralement pour un échange informel autour d'un verre et d'un mini-buffet.</p>
    </section>

    <section id="newsletter" class="newsletter-section">
      <div class="newsletter-card">
        <h2>Inscrivez-vous à notre lettre d'information</h2>
        <p>Recevez les informations sur les prochaines sessions, l'actualité de la communauté et nos événements.</p>

        <form method="post" action="https://newsletter.infomaniak.com/v3/api/1/newsletters/webforms/25697/submit" class="newsletter-form">
          <input type="text" name="inf_email_check" autocomplete="off" tabindex="-1" aria-hidden="true" style="display:none" />
          <input type="text" name="website" autocomplete="off" tabindex="-1" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;" />
          <input type="hidden" name="key" value="eyJpdiI6IlNFbkp4eHVtVDFtKzJsTE1VOUdRWUE5R0FNOEZndUE5XC9KOGc5QkR4NHpzPSIsIm1hYyI6ImYxN2E5ZDZiZGEyZWZlNDgxNjkzM2MyMzA1YmFkMjM3ZTE5NDNkOWI0YTgxYjlkYjE5MDM5NmMyMzliMTI4ZGQiLCJ2YWx1ZSI6IjJNZm5PTkdMS0hLcnFoYjVVOWlmR3RVektDMFEzMHRJSXJiOTFoSlN1Ync9In0=" />
          <input type="hidden" name="webform_id" value="25697" />

          <div class="newsletter-fields">
            <input type="email" name="inf[1]" data-inf-meta="1" data-inf-error="" required="required" placeholder="E-mail *" />
            <input type="text" name="inf[2]" data-inf-meta="2" data-inf-error="" placeholder="Prénom" />
            <input type="text" name="inf[3]" data-inf-meta="3" data-inf-error="" placeholder="Nom" />
          </div>

          <div class="newsletter-rgpd">
            Votre adresse de messagerie est uniquement utilisée pour vous envoyer notre lettre d'information ainsi que des informations concernant nos activités. Vous pouvez à tout moment utiliser le lien de désabonnement intégré dans chacun de nos mails.
          </div>

          <script src="https://newsletter.infomaniak.com/v3/static/mcaptcha/altcha.min.js?v=1789646400" type="module"></script>
          <altcha-widget hidelogo hidefooter floating challengeurl="https://newsletter.infomaniak.com/v3/altcha-challenge"></altcha-widget>
          <script src="https://newsletter.infomaniak.com/v3/static/mcaptcha/altcha-index.js?v=1789646400" defer></script>
          <script src="https://newsletter.infomaniak.com/v3/static/webform_index.js?v=1789646400"></script>

          <div class="newsletter-submit">
            <input type="submit" value="Valider" />
          </div>
        </form>
      </div>
    </section>

    <NextSession locale="fr" />
    <PastSessions locale="fr" />
    <Speakers locale="fr" />
    <Team locale="fr" />
  </body>
</html>
